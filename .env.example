# ---------------------------------------------------------------------------
# STREET/PLATINUM — environment configuration example
# Copy to .env and replace the placeholder values. Never commit the real .env.
# ---------------------------------------------------------------------------

# --- Server -----------------------------------------------------------------
# Port the Express API binds to (assigned by the deploy script)
PORT=4117
# Node environment: development | production
NODE_ENV=production

# --- MySQL database ---------------------------------------------------------
# Host running MySQL 8
DB_HOST=localhost
# MySQL user with access to the schema
DB_USER=streetclothing_user
# MySQL password for the user above
DB_PASSWORD=replace-with-database-password
# Database name created by `mysql < schema.sql`
DB_NAME=streetclothing

# --- Sessions ---------------------------------------------------------------
# Long random string used to sign the session cookie (e.g. `openssl rand -hex 32`)
SESSION_SECRET=replace-with-a-long-random-session-secret
# Cookie domain shared by the frontend and API hosts (leave blank for localhost)
SESSION_COOKIE_DOMAIN=.arx-app.com

# --- CORS -------------------------------------------------------------------
# Primary allowed browser origin (the storefront)
CLIENT_ORIGIN=https://streetclothing.arx-app.com

# --- TLS (terminated in the Node process) -----------------------------------
# Set to 'true' to serve HTTPS directly from Express
SSL_ENABLED=true
SSL_CERT_PATH=/home/arx-app/backends/certs/certificate.crt
SSL_KEY_PATH=/home/arx-app/backends/certs/private.key
# Optional CA bundle — leave blank if not required
SSL_CA_PATH=

# --- Frontend (exposed to the browser) --------------------------------------
# Base URL of the backend API used by the browser
NEXT_PUBLIC_API_BASE_URL=https://streetclothing-api.arx-app.com:4117

# --- Payments module --------------------------------------------------------
# Public frontend base URL the payment providers redirect back to
PAYMENTS_PUBLIC_URL=https://streetclothing.arx-app.com

# Stripe
STRIPE_SECRET_KEY=sk_test_replace_with_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret

# PayPal
PAYPAL_CLIENT_ID=replace_with_paypal_client_id
PAYPAL_CLIENT_SECRET=replace_with_paypal_client_secret

# Paystack
PAYSTACK_SECRET_KEY=sk_test_replace_with_paystack_secret_key

# Flutterwave
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-replace_with_flutterwave_secret_key
FLUTTERWAVE_WEBHOOK_HASH=replace_with_flutterwave_webhook_hash